# Copy this file to .env.local (not committed) and fill in your values.
# Restart the web server after changing this file (symfony serve, Apache, etc.).

###> symfony/mailer ###
# Brevo: https://app.brevo.com → SMTP & API → API keys (create key, paste below)
# Format: brevo+api://YOUR_API_KEY@default
MAILER_DSN=brevo+api://YOUR_BREVO_API_KEY@default

# Must be a sender verified in Brevo (Senders & IP → Senders → add + verify this address)
MAILER_FROM=your.name@gmail.com
CONTACT_TO=your.name@gmail.com
###< symfony/mailer ###

# Base URL in verification links — must match how you open the site in the browser
DEFAULT_URI=http://127.0.0.1:8000

# --- Troubleshooting (run from project folder) ---
# php bin/console app:test-mailer your@email.com
#
# If login says email could not be sent:
# 1. Brevo → Settings → Security → Authorized IPs — add your IP or disable restriction
# 2. Brevo → Senders — verify MAILER_FROM
# 3. Confirm .env.local exists and restart symfony serve / your web server
# 4. Check spam folder for "Verify your GearGrid account"
